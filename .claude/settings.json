{
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(bash *)",
      "Bash(cat *)",
      "Bash(cmp *)",
      "Bash(cp *)",
      "Bash(du *)",
      "Bash(exiftool *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git -C *)",
      "Bash(git add *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout -b *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git ls-tree *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git rev-list *)",
      "Bash(git show *)",
      "Bash(git worktree add *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(npm ls *)",
      "Bash(pdfimages *)",
      "Bash(pdfinfo *)",
      "Bash(pdftoppm *)",
      "Bash(pdftotext *)",
      "Bash(python3 *)",
      "Bash(sed *)",
      "Bash(sha256sum *)",
      "Bash(shasum *)",
      "Bash(sort *)",
      "Bash(tee *)",
      "Bash(tesseract *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(xxd *)"
    ],
    "deny": [
      "Bash(git -C * clean *)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean *)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
